# --- API Configuration ---
# آدرس اصلی بک‌اند (محلی)
NEXT_PUBLIC_API_BASE_URL=https://api.yadakchi.local

# آدرس سرور جستجوی OpenSearch (از سرور شما)
NEXT_PUBLIC_SEARCH_API_BASE_URL=http://172.92.92.237:7104

